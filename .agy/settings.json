{
  "permissions": {
    "allow": [
      "command(docker)",
      "command(git)",
      "command(uv)",
      "command(uvx)",
      "command(python)",
      "command(curl)"
    ],
    "deny": [
      "command(git push)",
      "command(git remote)",
      "command(gh)",
      "command(docker system)",
      "command(regex:docker \\S+ prune)",
      "command(docker rm)",
      "command(docker rmi)",
      "command(docker volume rm)",
      "command(docker network rm)"
    ]
  }
}
