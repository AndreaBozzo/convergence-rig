# Synthetic credentials for a local, localhost-only lab. They protect nothing:
# never reuse them, and never expose these services beyond 127.0.0.1.

# Port bindings (all bound to 127.0.0.1 in docker-compose.yml)
PG_SOURCE_PORT=15432
LAKEKEEPER_PORT=18181
SILO_PORT=19000
SILO_CONSOLE_PORT=19001
PG2ICEBERG_METRICS_PORT=19090

# Synthetic lab credentials (local only)
PG_SOURCE_USER=postgres
PG_SOURCE_PASSWORD=cdclab_pg_pass
PG_SOURCE_DB=cdclab

LAKEKEEPER_DB_USER=postgres
LAKEKEEPER_DB_PASSWORD=cdclab_lk_pass
LAKEKEEPER_DB_NAME=lakekeeper
LAKEKEEPER_ENCRYPTION_KEY=cdclab-synthetic-encryption-key-not-for-prod

SILO_ROOT_USER=cdclab-silo-user
SILO_ROOT_PASSWORD=cdclab-silo-pass
SILO_BUCKET=cdclab
SILO_REGION=local-01

LAKEKEEPER_WAREHOUSE=cdclab
LAKEKEEPER_NAMESPACE=public

# L2 authorization profile (all ports bound to 127.0.0.1; synthetic lab credentials only)
KEYCLOAK_PORT=18080
LAKEKEEPER_AUTHZ_PORT=18182
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cdclab_kc_admin_pass
KEYCLOAK_REALM=cdclab
OPENFGA_DB_USER=postgres
OPENFGA_DB_PASSWORD=cdclab_fga_pass
OPENFGA_DB_NAME=openfga
OPENFGA_OIDC_CLIENT_SECRET=cdclab-openfga-secret
LAKEKEEPER_AUTHZ_DB_USER=postgres
LAKEKEEPER_AUTHZ_DB_PASSWORD=cdclab_lk_authz_pass
LAKEKEEPER_AUTHZ_DB_NAME=lakekeeper_authz
LAKEKEEPER_AUTHZ_WAREHOUSE=cdclab_authz
AUTHZ_ADMIN_CLIENT_ID=cdclab-admin
AUTHZ_ADMIN_CLIENT_SECRET=cdclab-admin-secret
AUTHZ_WRITER_CLIENT_ID=cdclab-writer
AUTHZ_WRITER_CLIENT_SECRET=cdclab-writer-secret
AUTHZ_READER_CLIENT_ID=cdclab-reader
AUTHZ_READER_CLIENT_SECRET=cdclab-reader-secret

# P1 Apache Polaris profile (all ports bound to 127.0.0.1; synthetic lab credentials only)
POLARIS_PORT=18183
POLARIS_MGMT_PORT=18184
PG2ICEBERG_POLARIS_METRICS_PORT=19091
POLARIS_DB_USER=postgres
POLARIS_DB_PASSWORD=cdclab_polaris_pass
POLARIS_DB_NAME=polaris
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=cdclab_polaris_root_secret
POLARIS_CATALOG=cdclab_polaris
POLARIS_AUTHZ_CATALOG=cdclab_polaris_authz
