{
  "realm": "cdclab",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "clientScopes": [
    {
      "name": "basic",
      "description": "Basic OIDC claims (sub, auth_time)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Username claim for Lakekeeper user provisioning",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "lakekeeper",
      "description": "Audience scope for Lakekeeper catalog",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "Add lakekeeper Audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lakekeeper",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "openfga",
      "description": "Audience scope for OpenFGA authorizer",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "Add openfga Audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "openfga",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "lakekeeper",
      "name": "Lakekeeper Catalog",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["basic", "profile", "lakekeeper"]
    },
    {
      "clientId": "openfga",
      "name": "OpenFGA Service Client",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cdclab-openfga-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "profile", "openfga"],
      "optionalClientScopes": ["lakekeeper"]
    },
    {
      "clientId": "cdclab-admin",
      "name": "Synthetic Lab Admin",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cdclab-admin-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["lakekeeper"]
    },
    {
      "clientId": "cdclab-writer",
      "name": "Synthetic Lab Writer",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cdclab-writer-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["lakekeeper"]
    },
    {
      "clientId": "cdclab-reader",
      "name": "Synthetic Lab Reader",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cdclab-reader-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["lakekeeper"]
    }
  ]
}
